---
/**
 * What runs where, top to bottom: the droplets server, the line the build
 * enforces (vite/server-only.ts), the browser. The component and
 * +droplet.ts are in both bundles; server files never reach the browser,
 * and only the props and what a load returns cross, as JSON in the fragment.
 */
import Diagram from "./Diagram.astro";
import { Draw, NARROW, WIDE, textWidth, type Scene } from "./diagram-kit.ts";

const serverOnly = ["+droplet.server.ts", "hooks.server.ts", "+server.ts", "*.server.*", "server/", "$droplets/env/private"];
const both = ["+droplet.<ext>", "+droplet.ts", "$droplets/env/public"];
const browserOnly = ["hooks.client.ts"];

/** Chips left to right, wrapping at `right`; returns the bottom of the last row. */
function chips(d: Draw, x: number, top: number, right: number, groups: { labels: string[]; cls: string }[]): number {
  let cx = x;
  let y = top;
  const h = 26;
  for (const { labels, cls } of groups) {
    for (const label of labels) {
      const w = Math.round(textWidth(label, "codesm") + 16);
      if (cx + w > right) {
        cx = x;
        y += h + 8;
      }
      d.rect(cx, y, w, h, cls, 4);
      d.text(cx + w / 2, y + 17.5, label, "codesm", "", "middle");
      cx += w + 8;
    }
  }
  return y + h;
}

function build(narrow: boolean): Scene {
  const d = new Draw(narrow ? NARROW : WIDE);
  const inner = d.w - 16;
  // The server: its own files, then the ones both sides run.
  d.node();
  const serverMark = d.mark();
  d.text(22, 32, "Droplets server", "title", "acc");
  const serverBottom = chips(d, 22, 44, 8 + inner - 12, [
    { labels: serverOnly, cls: "zone" },
    { labels: both, cls: "drop" },
  ]);
  d.rectUnder(serverMark, 8, 8, inner, serverBottom - 8 + 14, "drop-solid", 8);

  const gapTop = serverBottom + 14;
  const gap = narrow ? 128 : 110;
  const wallY = gapTop + gap - (narrow ? 38 : 34);
  d.line(8, wallY, d.w - 8, wallY, "wall", false);

  // Code: stopped at the line. Data: through it.
  const xNo = narrow ? 56 : 120;
  const xData = narrow ? 200 : 360;
  d.line(xNo, gapTop + 2, xNo, gapTop + gap - 4, "arrow dashed");
  d.path(`M${xNo - 8} ${wallY - 8} L${xNo + 8} ${wallY + 8} M${xNo + 8} ${wallY - 8} L${xNo - 8} ${wallY + 8}`, "wall", false);
  d.node();
  d.tag(xNo + 16, gapTop + 10, narrow ? "server code:\nthe build fails" : "server code: the build fails", "small", "danger");
  d.line(xData, gapTop + 2, xData, gapTop + gap - 4, "arrow accent");
  d.node();
  d.tag(xData + 12, gapTop + 10, narrow ? "props and load\ndata, as JSON in\nthe fragment" : "props and load data,\nas JSON in the fragment", "small", "acc");

  // The browser: the same component and +droplet.ts, and its own hook.
  d.node();
  const browserTop = gapTop + gap;
  const browserMark = d.mark();
  d.text(22, browserTop + 24, "Browser", "title", "acc2");
  const browserBottom = chips(d, 22, browserTop + 36, 8 + inner - 12, [
    { labels: both, cls: "drop" },
    { labels: browserOnly, cls: "host" },
  ]);
  d.rectUnder(browserMark, 8, browserTop, inner, browserBottom - browserTop + 14, "host", 8);
  const legendTop = browserBottom + 26;
  d.rect(8, legendTop, 22, 14, "drop", 3);
  const end = d.para(38, legendTop - 1, d.w - 46, "in both bundles: rendered on the server, run again in the browser", "small");
  return d.scene(end + 6);
}
---

<Diagram
  id="runs-where"
  title="What runs where"
  desc="On the droplets server: +droplet.server.ts, hooks.server.ts, +server.ts endpoints, any *.server.* file or server/ folder, and $droplets/env/private, which only the server runs; and the component +droplet.<ext>, +droplet.ts and $droplets/env/public, which the server renders and the browser runs again. Between the server and the browser is a line the build enforces: server code that browser code reaches fails vite build and the vite dev import. What crosses is data: the props and the load's result, as JSON in the fragment. In the browser: the component, +droplet.ts, $droplets/env/public and hooks.client.ts."
  caption="Server code never crosses the line; the props and what a load returns do, as JSON in the fragment."
  wide={build(false)}
  narrow={build(true)}
/>
