---
/**
 * The droplet tour: the shop on a WordPress page with the dev tool's
 * overlay on, each droplet named as the pointer reaches it, then a comment
 * posted live. The files are public/hosts/tour.mp4 and its poster tour.webp.
 */
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<figure class="droplet-tour">
  <video controls muted playsinline preload="metadata" poster={`${base}hosts/tour.webp`} width="1034" height="720">
    <source src={`${base}hosts/tour.mp4`} type="video/mp4" />
  </video>
  <figcaption>
    The shop on a WordPress page: hover a droplet for its framework, SSR, hydration, prerender and
    actions; then a comment goes up live.
  </figcaption>
</figure>

<style>
  .droplet-tour {
    margin: 0 0 2rem;
  }
  .droplet-tour video {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--djs-line);
    border-radius: var(--djs-radius-md, 8px);
    background: var(--djs-surface-300);
  }
  .droplet-tour figcaption {
    margin-top: 0.4rem;
    font-size: var(--sl-text-sm);
    color: var(--djs-ink-muted);
  }
</style>
