---
/**
 * The WordPress host as a sequence: WordPress renders the page and asks
 * wp-shop for the fragments on its server (shop.php
 * droplets_shop_fragments, all at once); wp-shop's loads read the catalogue
 * back from WordPress's REST API (examples/wp-shop src/lib/server/wp.ts);
 * the browser reaches wp-shop only through the plugin's proxy
 * (droplets_shop_route_proxy). The admin's signed header is in the prose.
 */
import Diagram from "./Diagram.astro";
import { Draw, NARROW, WIDE, sequence, type SequenceStep } from "./diagram-kit.ts";

const heads = [
  { name: "Browser", cls: "node", ink: "" },
  { name: "WordPress", cls: "host", ink: "acc2" },
  { name: "wp-shop", cls: "drop-solid", ink: "acc" },
];

const steps: SequenceStep[] = [
  { from: 0, to: 1, text: "① GET /gallery" },
  { from: 1, to: 2, text: "② GET /droplets/<id>, all at once\nx-droplet-location, Cookie" },
  { from: 2, to: 1, text: "③ GET /wp-json/wp/v2/products, media, comments" },
  { from: 1, to: 2, res: true, text: "④ JSON" },
  { from: 2, to: 1, res: true, text: "⑤ the fragments" },
  { from: 1, to: 0, res: true, text: "⑥ the page, fragments pasted in" },
  { from: 0, to: 1, text: "⑦ /index.js, /droplets/*, /assets/*, /api/*" },
  { from: 1, to: 2, text: "⑧ proxied, x-droplet-location set" },
];
---

<Diagram
  id="wordpress-flow"
  title="WordPress renders, wp-shop reads WordPress"
  desc="One, the browser asks WordPress for a page, /gallery. Two, the plugin fetches the page's fragments from wp-shop on the server, all at once, with x-droplet-location, the cart cookie and, for a logged-in admin, a signed x-wp-shop-user. Three, each droplet's load asks WordPress's REST API under /wp-json/wp/v2/ for its data: the products, their images, their comments. Four, WordPress answers JSON, which wp-shop checks field by field. Five, wp-shop answers the fragments. Six, WordPress sends the page with the fragments pasted in. Seven, the browser asks for /index.js, /droplets/*, /assets/* and /api/* on WordPress's own origin. Eight, the plugin's proxy passes them on to wp-shop, with x-droplet-location set."
  caption="WordPress renders the page and asks wp-shop for fragments; wp-shop reads its data back from WordPress."
  wide={sequence(new Draw(WIDE), heads, steps)}
  narrow={sequence(new Draw(NARROW), heads, steps)}
/>
