---
/**
 * The same testimonials list rendered by five demo droplets, one per flag
 * combination (apps/demo/src/droplets/testimonials-*), live from the demo
 * server. A tab fetches its droplet's fragment when it first opens and
 * inserts it through a <template>, so the request shows in the console
 * below; the prerendered tab fetches the exported page-<n>.html files
 * instead (the live route under `astro dev`, where the demo builds none).
 *
 * At build each fragment is fetched once (live-droplet.ts): a droplet the
 * demo does not render fails the build. The script is bundled to a file:
 * the site's CSP allows no inline code.
 */
import { DEMO_ELEMENT, demoPublicUrl, fetchFragment } from "./live-droplet.ts";

type Example = { id: string; name: string; flags: string; what: string; props?: Record<string, unknown> };

const examples: Example[] = [
  {
    id: "testimonials-client-only",
    name: "Client only",
    flags: "ssr = false · hydrate = true",
    what: "Nothing rendered on the server. In the browser the load reads IndexedDB and, on a miss, fetches /api/testimonials from the droplet location.",
  },
  {
    id: "testimonials-server-client",
    name: "Server, then client",
    flags: "ssr = true · hydrate = true",
    what: "Rendered on the server; the load calls event.fetch, answered in-process. Hydrated here, so Refresh fetches ten more from the API.",
  },
  {
    id: "testimonials-server-only",
    name: "Server only",
    flags: "ssr = true · hydrate = false",
    what: "Rendered on the server through event.fetch, sent as HTML. No JavaScript, so no Refresh button.",
  },
  {
    id: "testimonials-prerender-only",
    name: "Prerendered",
    flags: "ssr = false · hydrate = false · prerender = true",
    what: "Rendered at build for pages 1 to 10, exported as files. The pager fetches each page as a static file.",
    props: { page: 1 },
  },
  {
    id: "testimonials-none",
    name: "None",
    flags: "ssr = false · hydrate = false · prerender = false",
    what: "Nothing anywhere: no markup, no JavaScript, no render at build. The fragment is an empty element.",
  },
];

const PAGES = 10;
const demo = demoPublicUrl();
const page = new URL(Astro.url.pathname, Astro.url.origin).href;
for (const example of examples) await fetchFragment(example.id, example.props ?? {}, page);

// The exported files exist only in a build of the demo; its dev server renders the route live.
const pageUrl = import.meta.env.DEV
  ? `${demo}/droplets/testimonials-prerender-only?page=`
  : `${demo}/assets/public/testimonials/page-`;
const pageSuffix = import.meta.env.DEV ? "" : ".html";
---

<section class="dx droplet-examples not-content" aria-label="Examples: one list, five droplets" data-dx data-demo={demo} data-element={DEMO_ELEMENT} data-page-url={pageUrl} data-page-suffix={pageSuffix}>
  <script is:inline type="module" src={`${demo}/index.js`}></script>
  <p class="dx-title">Examples</p>
  <div class="dx-box">
    <div class="dx-tabs" role="tablist" aria-orientation="vertical" aria-label="Flag combinations">
      {
        examples.map((example, i) => (
          <button
            type="button"
            role="tab"
            class="dx-tab"
            id={`dx-tab-${example.id}`}
            aria-controls={`dx-panel-${example.id}`}
            aria-selected={i === 0 ? "true" : "false"}
            tabindex={i === 0 ? 0 : -1}
            data-dx-tab={example.id}
          >
            <span class="dx-name">{example.name}</span>
            <code class="dx-flags">
              {example.flags.split(" · ").map((flag) => (
                <span>{flag}</span>
              ))}
            </code>
            <span class="dx-what">{example.what}</span>
          </button>
        ))
      }
    </div>
    <div class="dx-stage">
      {
        examples.map((example, i) => (
          <div
            class="dx-panel"
            role="tabpanel"
            id={`dx-panel-${example.id}`}
            aria-labelledby={`dx-tab-${example.id}`}
            tabindex="0"
            hidden={i !== 0}
            data-dx-panel={example.id}
          >
            {example.id === "testimonials-prerender-only" && (
              <div class="dx-pager" data-dx-pager>
                <button type="button" class="dx-step" data-dx-step="-1" aria-label="Previous page">
                  &lt;
                </button>
                <label>
                  <span class="dx-sr">Page</span>
                  <select data-dx-page>
                    {Array.from({ length: PAGES }, (_, n) => (
                      <option value={n + 1}>Page {n + 1}</option>
                    ))}
                  </select>
                </label>
                <button type="button" class="dx-step" data-dx-step="1" aria-label="Next page">
                  &gt;
                </button>
              </div>
            )}
            <p class="dx-request" data-dx-request>Opens when the tab does.</p>
            <div class="dx-render" data-dx-render />
            {example.id === "testimonials-none" && (
              <p class="dx-note">
                The element above is all there is: the fragment the server answers, with no markup in it and no script to
                fill it.
              </p>
            )}
          </div>
        ))
      }
      <noscript><p class="dx-note">The examples load their droplets with JavaScript.</p></noscript>
    </div>
  </div>
  <div class="dx-console" aria-label="Network requests the examples make">
    <div class="dx-console-head">
      <p>Network, from this page</p>
      <button type="button" class="dx-clear" data-dx-clear>Clear</button>
    </div>
    <ol class="dx-log" data-dx-log aria-live="polite"></ol>
    <p class="dx-note">
      What this page asks the demo server for: the fragments and API calls (<code>fetch</code>), and the modules and
      stylesheets the droplets load. A server load's <code>event.fetch</code> never shows here: it runs on the demo
      server, inside the request for the fragment.
    </p>
  </div>
</section>

<script>
  type Line = { method: string; url: string; status: number | string; ms: number; kind: string };

  const MAX_LINES = 60;

  for (const root of document.querySelectorAll<HTMLElement>("[data-dx]")) {
    const demo = root.dataset["demo"] ?? "";
    const demoOrigin = new URL(demo).origin;
    const element = root.dataset["element"] ?? "";
    const pageUrl = root.dataset["pageUrl"] ?? "";
    const pageSuffix = root.dataset["pageSuffix"] ?? "";
    const log = root.querySelector<HTMLOListElement>("[data-dx-log]");
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-dx-tab]")];
    const loaded = new Set<string>();

    const short = (url: string) => (url.startsWith(demoOrigin) ? url.slice(demoOrigin.length) || "/" : url);

    function addLine({ method, url, status, ms, kind }: Line) {
      if (!log) return;
      const item = document.createElement("li");
      const ok = typeof status === "number" && status >= 200 && status < 400;
      for (const [text, cls] of [
        [method, "dx-m"],
        [String(status), ok ? "dx-s dx-ok" : "dx-s dx-bad"],
        [`${Math.round(ms)} ms`, "dx-t"],
        [short(url), "dx-u"],
        [kind, "dx-k"],
      ] as const) {
        const cell = document.createElement("span");
        cell.className = cls;
        cell.textContent = text;
        item.append(cell);
      }
      item.title = url;
      log.prepend(item);
      while (log.children.length > MAX_LINES) log.lastElementChild?.remove();
    }

    // Every fetch on this page that goes to the demo: the fragments the tabs
    // ask for and what the droplets ask for themselves (the API, _data).
    const pageFetch = window.fetch.bind(window);
    window.fetch = async (input, init) => {
      // Read, never cloned: a Request passed on keeps its body.
      const url = new URL(input instanceof Request ? input.url : String(input), location.href).href;
      if (new URL(url).origin !== demoOrigin) return pageFetch(input, init);
      const method = (init?.method ?? (input instanceof Request ? input.method : "GET")).toUpperCase();
      const start = performance.now();
      try {
        const response = await pageFetch(input, init);
        addLine({ method, url, status: response.status, ms: performance.now() - start, kind: "fetch" });
        return response;
      } catch (error) {
        addLine({ method, url, status: "failed", ms: performance.now() - start, kind: "fetch" });
        throw error;
      }
    };

    // Modules and stylesheets the browser loads from the demo; fetches are logged above.
    new PerformanceObserver((list) => {
      for (const entry of list.getEntries() as PerformanceResourceTiming[]) {
        if (!entry.name.startsWith(`${demoOrigin}/`) || entry.initiatorType === "fetch") continue;
        const kind = /\.css(\?|$)/.test(entry.name) ? "stylesheet" : "module";
        addLine({ method: "GET", url: entry.name, status: entry.responseStatus || "-", ms: entry.duration, kind });
      }
    }).observe({ type: "resource", buffered: true });

    root.querySelector("[data-dx-clear]")?.addEventListener("click", () => log?.replaceChildren());

    /** Removes what the render space holds and inserts the answer, parsed through a <template>. */
    async function show(panel: HTMLElement, url: string) {
      const render = panel.querySelector<HTMLElement>("[data-dx-render]");
      const line = panel.querySelector<HTMLElement>("[data-dx-request]");
      if (!render || !line) return;
      line.textContent = `GET ${short(url)} …`;
      try {
        const response = await fetch(url, { headers: { accept: "text/html" } });
        const html = await response.text();
        line.textContent = `GET ${short(url)} → ${response.status}`;
        if (!response.ok || !html.trimStart().startsWith(`<${element}`)) throw new Error(`${response.status}`);
        const template = document.createElement("template");
        template.innerHTML = html;
        render.replaceChildren(template.content);
      } catch {
        line.textContent = `GET ${short(url)}: the demo server did not answer with its fragment.`;
        render.replaceChildren();
      }
    }

    const prerenderPage = (n: number) => `${pageUrl}${n}${pageSuffix}`;

    function open(tab: HTMLButtonElement, focus: boolean) {
      for (const other of tabs) {
        const selected = other === tab;
        other.setAttribute("aria-selected", String(selected));
        other.tabIndex = selected ? 0 : -1;
        const panel = root.querySelector<HTMLElement>(`#${other.getAttribute("aria-controls")}`);
        if (panel) panel.hidden = !selected;
      }
      if (focus) tab.focus();
      const id = tab.dataset["dxTab"] ?? "";
      const panel = root.querySelector<HTMLElement>(`[data-dx-panel="${id}"]`);
      if (!panel || loaded.has(id)) return;
      loaded.add(id);
      const select = panel.querySelector<HTMLSelectElement>("[data-dx-page]");
      void show(panel, select ? prerenderPage(Number(select.value)) : `${demo}/droplets/${id}`);
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => open(tab, false));
      tab.addEventListener("keydown", (event) => {
        const step = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 }[event.key];
        const to = step ? tabs[(i + step + tabs.length) % tabs.length] : event.key === "Home" ? tabs[0] : event.key === "End" ? tabs.at(-1) : undefined;
        if (!to) return;
        event.preventDefault();
        open(to, true);
      });
    });

    const pager = root.querySelector<HTMLElement>("[data-dx-pager]");
    const select = pager?.querySelector<HTMLSelectElement>("[data-dx-page]");
    const pagerPanel = pager?.closest<HTMLElement>("[data-dx-panel]");
    if (pager && select && pagerPanel) {
      const go = (n: number) => {
        const next = Math.min(Math.max(n, 1), select.options.length);
        select.value = String(next);
        void show(pagerPanel, prerenderPage(next));
      };
      select.addEventListener("change", () => go(Number(select.value)));
      for (const button of pager.querySelectorAll<HTMLButtonElement>("[data-dx-step]")) {
        button.addEventListener("click", () => go(Number(select.value) + Number(button.dataset["dxStep"])));
      }
    }

    // The first tab's fragment is fetched once the box is about to scroll into view.
    const first = tabs[0];
    if (first) {
      const seen = new IntersectionObserver(
        (entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          seen.disconnect();
          if (!loaded.size) open(tabs.find((tab) => tab.getAttribute("aria-selected") === "true") ?? first, false);
        },
        { rootMargin: "300px 0px" },
      );
      seen.observe(root);
    }
  }
</script>

<style>
  .dx {
    container-type: inline-size;
    margin: 1.5rem 0 2rem;
    color: var(--djs-ink);
    font-family: var(--djs-font-sans, system-ui, sans-serif);
  }
  .dx p {
    margin: 0;
  }
  .dx .dx-title {
    margin-bottom: 0.5rem;
    font-size: var(--sl-text-lg);
    font-weight: 600;
  }
  .dx-box {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border: 1px solid var(--djs-line);
    border-radius: var(--djs-radius-md);
    background: var(--djs-surface-200);
    overflow: hidden;
  }
  .dx-tabs {
    display: flex;
    flex-direction: column;
    border-bottom: 1px solid var(--djs-line);
    background: var(--djs-surface-100);
  }
  @container (min-width: 38rem) {
    .dx-box {
      grid-template-columns: 14rem minmax(0, 1fr);
    }
    .dx-tabs {
      border-right: 1px solid var(--djs-line);
      border-bottom: 0;
    }
  }
  .dx-tab {
    display: grid;
    gap: 0.2rem;
    padding: 0.625rem 0.875rem;
    border: 0;
    border-left: 3px solid transparent;
    background: none;
    color: var(--djs-ink-muted);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .dx-tab + .dx-tab {
    border-top: 1px solid var(--djs-line);
  }
  .dx-tab:hover {
    background: var(--djs-surface-300);
  }
  .dx-tab[aria-selected="true"] {
    border-left-color: var(--djs-accent);
    background: var(--djs-surface-200);
    color: var(--djs-ink);
  }
  .dx-tab:focus-visible,
  .dx-step:focus-visible,
  .dx-clear:focus-visible,
  .dx-panel:focus-visible,
  .dx-pager select:focus-visible {
    outline: 2px solid var(--djs-focus);
    outline-offset: -2px;
  }
  .dx-name {
    font-size: var(--sl-text-sm);
    font-weight: 600;
    color: var(--djs-ink);
  }
  .dx-flags {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.75rem;
    padding: 0;
    background: none;
    color: var(--djs-accent-text);
    font: 500 0.72rem / 1.4 var(--djs-font-mono, ui-monospace, monospace);
  }
  .dx-flags span {
    white-space: nowrap;
  }
  .dx-what {
    font-size: 0.78rem;
    line-height: 1.45;
  }
  /* Stacked above the render space: only the open tab says what happens. */
  @container (max-width: 37.99rem) {
    .dx-tab {
      padding-block: 0.5rem;
    }
    .dx-tab[aria-selected="false"] .dx-what {
      display: none;
    }
  }
  .dx-stage {
    position: relative;
    min-width: 0;
    padding: 0.875rem;
  }
  .dx-panel {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .dx-panel[hidden] {
    display: none;
  }
  /* Side by side, the tabs set the box's height and the render space fills the rest. */
  @container (min-width: 38rem) {
    .dx-panel {
      position: absolute;
      inset: 0.875rem;
    }
  }
  .dx-request {
    color: var(--djs-ink-muted);
    font: 0.72rem / 1.4 var(--djs-font-mono, ui-monospace, monospace);
    overflow-wrap: anywhere;
  }
  .dx-render {
    max-height: 30rem;
    min-height: 6rem;
    padding: 0.75rem;
    border: 1px dashed var(--djs-line-strong);
    border-radius: var(--djs-radius-md);
    background: var(--djs-surface-100);
    overflow: auto;
  }
  @container (min-width: 38rem) {
    .dx-render {
      flex: 1;
      max-height: none;
    }
  }
  .dx-pager {
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }
  .dx-step,
  .dx-clear,
  .dx-pager select {
    min-height: 2.25rem;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--djs-line-strong);
    border-radius: var(--djs-radius-sm);
    background: var(--djs-surface-300);
    color: var(--djs-ink);
    font: inherit;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    cursor: pointer;
  }
  .dx-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .dx-note {
    color: var(--djs-ink-muted);
    font-size: var(--sl-text-sm);
  }
  .dx-console {
    margin-top: 0.75rem;
    padding: 0.625rem 0.875rem 0.75rem;
    border: 1px solid var(--djs-line);
    border-radius: var(--djs-radius-md);
    background: var(--djs-surface-100);
  }
  .dx-console-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
    font-size: var(--sl-text-sm);
    font-weight: 600;
  }
  .dx-clear {
    min-height: 1.875rem;
    padding: 0.125rem 0.625rem;
    font-size: 0.75rem;
  }
  .dx-log {
    display: grid;
    gap: 0.125rem;
    max-height: 12rem;
    min-height: 2rem;
    margin: 0 0 0.5rem;
    padding: 0.375rem 0.5rem;
    border-radius: var(--djs-radius-sm);
    background: var(--djs-surface-300);
    list-style: none;
    overflow: auto;
    font: 0.72rem / 1.5 var(--djs-font-mono, ui-monospace, monospace);
  }
  .dx-log :global(li) {
    display: grid;
    grid-template-columns: 2.5rem 3.25rem 4rem minmax(0, 1fr) auto;
    gap: 0.5rem;
    margin: 0;
  }
  .dx-log :global(.dx-u) {
    overflow: hidden;
    color: var(--djs-ink);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .dx-log :global(.dx-m),
  .dx-log :global(.dx-t),
  .dx-log :global(.dx-k) {
    color: var(--djs-ink-muted);
  }
  .dx-log :global(.dx-ok) {
    color: var(--djs-success);
  }
  .dx-log :global(.dx-bad) {
    color: var(--djs-danger);
  }
  @container (max-width: 30rem) {
    .dx-log :global(li) {
      grid-template-columns: 2.5rem 3.25rem minmax(0, 1fr);
    }
    .dx-log :global(.dx-t),
    .dx-log :global(.dx-k) {
      display: none;
    }
  }
</style>
