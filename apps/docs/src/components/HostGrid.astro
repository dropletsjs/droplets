---
/**
 * The hosts of examples/hosts/hosts.json by language, each its gallery as
 * the end-to-end test recorded it (public/hosts/<id>/1-gallery.webp,
 * written by `pnpm test:hosts --docs`), linking to that host's page. A host
 * not recorded yet, or one the runner does not run, gets a plain tile.
 */
import { hostsByLanguage } from "@dropletsjs/shared/hosts";
import { hasHostFile } from "./host-media.ts";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const groups = hostsByLanguage();
---

<div class="host-grid">
  {
    groups.map(({ language, hosts }) => (
      <section aria-label={language.label}>
        <h3>{language.label}</h3>
        <ul>
          {hosts.map((host) => (
            <li>
              <a href={`${base}${host.docs}/`}>
                {hasHostFile(`${host.id}/1-gallery.webp`) ? (
                  <img
                    src={`${base}hosts/${host.id}/1-gallery.webp`}
                    alt={`The shop demo's gallery on ${host.name}`}
                    width="1280"
                    height="800"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span class="host-grid-pending">{host.runner ? "Not recorded yet" : "A guide, no example"}</span>
                )}
                <span>{host.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>

<style>
  .host-grid {
    margin: 1rem 0 1.5rem;
  }
  .host-grid h3 {
    margin: 1.25rem 0 0.5rem;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--djs-ink-muted);
  }
  .host-grid ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .host-grid li {
    margin: 0;
  }
  .host-grid a {
    display: block;
    text-decoration: none;
    color: var(--djs-ink);
  }
  .host-grid img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--djs-line);
    border-radius: var(--djs-radius-sm, 4px);
  }
  .host-grid .host-grid-pending {
    display: grid;
    place-items: center;
    aspect-ratio: 1280 / 800;
    margin: 0;
    border: 1px dashed var(--djs-line);
    border-radius: var(--djs-radius-sm, 4px);
    font-size: var(--sl-text-xs);
    color: var(--djs-ink-muted);
  }
  .host-grid a:hover img,
  .host-grid a:focus-visible img,
  .host-grid a:hover .host-grid-pending,
  .host-grid a:focus-visible .host-grid-pending {
    border-color: var(--djs-accent);
  }
  .host-grid a > span:last-child {
    display: block;
    margin-top: 0.25rem;
    font-size: var(--sl-text-sm);
  }
</style>
