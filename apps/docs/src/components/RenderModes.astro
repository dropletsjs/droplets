---
/**
 * The render modes as four flows: what the server does, what the host
 * page receives (empty or server markup) and what the droplet's
 * JavaScript does. The flags are those of guides/writing-droplets#flags.
 */
import Diagram from "./Diagram.astro";
import { Draw, type Scene } from "./diagram-kit.ts";

type Mode = { name: string; server: string; markup: boolean; js: string | null };

const modes: Mode[] = [
  { name: "Client-only", server: "load only", markup: false, js: "mount" },
  { name: "SSR + hydrate", server: "render", markup: true, js: "hydrate" },
  { name: "SSR only", server: "render", markup: true, js: null },
  { name: "Prerendered", server: "build", markup: true, js: "per flag" },
];

/** The host page's copy of the droplet: server markup, or nothing yet. */
function page(d: Draw, x: number, y: number, w: number, h: number, markup: boolean): void {
  d.rect(x, y, w, h, "drop", 5);
  if (markup) {
    d.rect(x + 10, y + 9, w * 0.5, 7, "bar-accent", 2);
    d.rect(x + 10, y + 21, w - 22, 5, "bar", 2);
  } else d.rect(x + 8, y + 7, w - 16, h - 14, "none", 3);
}

function jsNode(d: Draw, x: number, y: number, w: number, h: number, js: string | null): void {
  if (js) d.box(x, y, w, h, "drop-solid", js, "label", "acc");
  else d.box(x, y, w, h, "none", "no JS", "label", "muted");
}

function wide(): Scene {
  const d = new Draw(640);
  const row = 48;
  modes.forEach((m, i) => {
    const y = 10 + i * row;
    d.text(10, y + 21, m.name, "title", i === 1 ? "acc" : "");
    d.box(170, y, 120, 32, "zone", m.server);
    d.line(292, y + 16, 336, y + 16);
    page(d, 340, y, 120, 32, m.markup);
    d.line(462, y + 16, 506, y + 16, m.js ? "arrow" : "arrow dashed");
    jsNode(d, 510, y, 120, 32, m.js);
  });
  return d.scene(10 + modes.length * row - 8);
}

function narrow(): Scene {
  const d = new Draw(360, 1.1);
  const row = 66;
  modes.forEach((m, i) => {
    const y = 10 + i * row;
    d.text(10, y + 14, m.name, "label", i === 1 ? "acc" : "");
    page(d, 10, y + 22, 150, 32, m.markup);
    d.line(162, y + 38, 196, y + 38, m.js ? "arrow" : "arrow dashed");
    jsNode(d, 200, y + 22, 150, 32, m.js);
  });
  return d.scene(10 + modes.length * row - 6);
}
---

<Diagram
  id="render-modes"
  title="The render modes side by side"
  desc="Client-only (ssr = false): the server runs the load only; the host page receives the element with its data and no markup; the bundle mounts the droplet at once. SSR + hydrate, the default: the server renders; the page gets the markup; the bundle hydrates it at once, when visible or on the first interaction. SSR only (hydrate = false): the server renders; the page gets the markup; no JavaScript ever. Prerendered (prerender = true): rendered at build for the props in entries, host tokens filled in per request, other props live; JavaScript as its hydrate flag says."
  caption="What the server does, what the host page gets, and what the JavaScript does, per mode."
  wide={wide()}
  narrow={narrow()}
/>
