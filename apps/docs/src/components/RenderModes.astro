---
/**
 * The render modes as four columns, top to bottom: what the server does,
 * what the fragment carries to the host page, what the browser does. The
 * flags are those of guides/writing-droplets#flags; the fragment parts are
 * runtime/app.ts's (no markup without SSR, no inline data without hydrate).
 */
import Diagram from "./Diagram.astro";
import { Draw, NARROW, WIDE, wrap, type Kind, type Scene } from "./diagram-kit.ts";

type Mode = { name: string; flags: string; server: string; carries: string; browser: string; js: boolean };

const modes: Mode[] = [
  { name: "Client-only", flags: "ssr = false", server: "runs the load only", carries: "data, no markup", browser: "mounts at once", js: true },
  { name: "SSR + hydrate", flags: "the default", server: "renders per request", carries: "markup + data", browser: "hydrates: at once, when visible or on interaction", js: true },
  { name: "SSR only", flags: "hydrate = false", server: "renders per request", carries: "markup only", browser: "no JavaScript, no bundle", js: false },
  { name: "Prerendered", flags: "prerender = true", server: "rendered at build for entries; other props live", carries: "stored markup + data", browser: "as its hydrate flag says", js: true },
];

function lines(s: string, width: number, kind: Kind): number {
  return wrap(s, width, kind).length;
}

function build(narrow: boolean): Scene {
  const d = new Draw(narrow ? NARROW : WIDE);
  const perRow = narrow ? 2 : 4;
  const gap = 8;
  const cw = (d.w - 16 - gap * (perRow - 1)) / perRow;
  const tw = cw - 16;
  const lh = d.lh("body");
  const boxH = (key: "server" | "browser") => Math.max(...modes.map((m) => lines(m[key], tw, "body"))) * lh + 18;
  const serverH = boxH("server");
  const browserH = boxH("browser");
  const arrowH = 46;
  const colH = 44 + serverH + arrowH + browserH;

  modes.forEach((m, i) => {
    const x = 8 + (i % perRow) * (cw + gap);
    const top = 8 + Math.floor(i / perRow) * (colH + 24);
    const mid = x + cw / 2;
    d.text(mid, top + 15, m.name, "title", i === 1 ? "acc" : "", "middle");
    d.text(mid, top + 33, m.flags, "codesm", "muted", "middle");

    const sy = top + 44;
    d.node();
    const sm = d.mark();
    d.para(mid, sy + (serverH - d.measure(m.server, tw, "body")) / 2, tw, m.server, "body", "ink", "middle");
    d.rectUnder(sm, x, sy, cw, serverH, "zone");

    const ay = sy + serverH;
    d.line(mid, ay + 2, mid, ay + arrowH - 2);
    d.tag(mid, ay + arrowH / 2 - 11, m.carries, "small", "ink", "middle");

    const by = ay + arrowH;
    d.node();
    const bm = d.mark();
    d.para(mid, by + (browserH - d.measure(m.browser, tw, "body")) / 2, tw, m.browser, "body", m.js ? "acc" : "muted", "middle");
    d.rectUnder(bm, x, by, cw, browserH, m.js ? "drop-solid" : "none");
  });
  const rows = Math.ceil(modes.length / perRow);
  return d.scene(8 + rows * colH + (rows - 1) * 24 + 6);
}
---

<Diagram
  id="render-modes"
  title="The render modes side by side"
  desc="Client-only (ssr = false): the server runs the load only; the fragment carries the data and no markup; the browser mounts the droplet at once. SSR + hydrate, the default: the server renders per request; the fragment carries the markup and the data; the browser hydrates it at once, when visible or on the first interaction. SSR only (hydrate = false): the server renders; the fragment carries the markup only; no JavaScript and no bundle. Prerendered (prerender = true): rendered at build for the props entries lists, other props live; the fragment carries the stored markup and data; the browser does as the hydrate flag says."
  caption="What the server does, what the fragment brings the host page, and what the browser does, per mode."
  wide={build(false)}
  narrow={build(true)}
/>
