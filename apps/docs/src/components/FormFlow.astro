---
/**
 * A form action posted without JavaScript, as a sequence: the post goes
 * to the droplets server, which answers 303 back to the host page with the
 * result signed in its query (__droplet_form_<droplet>_<build>), and the
 * next render shows it (runtime/app.ts, a native post with DROPLETS_SECRET
 * set). The other cases are in the prose.
 */
import Diagram from "./Diagram.astro";
import { Draw, NARROW, WIDE, sequence, type SequenceStep } from "./diagram-kit.ts";

const heads = [
  { name: "Browser", cls: "node", ink: "" },
  { name: "Host", cls: "host", ink: "acc2" },
  { name: "Droplets server", cls: "drop-solid", ink: "acc" },
];

const steps: SequenceStep[] = [
  { from: 0, to: 2, text: "① POST /droplets/cart?/add\n__droplet_return: the page" },
  { self: 2, text: "Origin check, the action runs" },
  { from: 2, to: 0, res: true, text: "② 303 to the page, the result signed in\n?__droplet_form_cart_<build>=…" },
  { from: 0, to: 1, text: "③ GET the page, with that query" },
  { from: 1, to: 2, text: "④ GET /droplets/cart\nhost: the page's URL" },
  { self: 2, text: "verifies it, renders with form" },
  { from: 2, to: 1, res: true, text: "⑤ the fragment" },
  { from: 1, to: 0, res: true, text: "⑥ the page, result shown" },
];
---

<Diagram
  id="form-flow"
  title="A form action, Post/Redirect/Get"
  desc="Without JavaScript: one, the browser posts the form to the droplets server at /droplets/cart?/add, with __droplet_return naming the page. The droplets server checks the Origin and runs the action. Two, it answers 303 back to the host page, the result signed with DROPLETS_SECRET in a __droplet_form_cart_<build> query key, valid five minutes. Three, the browser loads the page again, with that query. Four, the host fetches the droplet with the page's URL and query as host. The droplets server verifies the signature and renders with the result as form. Five, it answers the fragment. Six, the page shows the result; a reload never posts again."
  caption="Posted without JavaScript, the form lands back on the host page, its result signed in the URL."
  wide={sequence(new Draw(WIDE), heads, steps)}
  narrow={sequence(new Draw(NARROW), heads, steps)}
/>
