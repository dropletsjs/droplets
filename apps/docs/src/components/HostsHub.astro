---
/**
 * The eleven hosts of examples/hosts/ by who fetches the fragment: nine on
 * their server (a server include), the React SPA and the htmx page in the
 * browser. One droplets server feeds both. The proxy every example runs is
 * in the prose under the figure.
 */
import Diagram from "./Diagram.astro";
import { Draw, NARROW, WIDE, type Scene } from "./diagram-kit.ts";

const serverHosts = "Express, Next.js, SvelteKit, Astro, FastAPI, Sinatra, PHP, WordPress, nginx SSI";
const browserHosts = "React SPA, htmx";

function build(narrow: boolean): Scene {
  const d = new Draw(narrow ? NARROW : WIDE);
  const colW = (d.w - 16 - 16) / 2;
  const lx = 8;
  const rx = 8 + colW + 16;
  const arrowH = narrow ? 92 : 78;

  d.text(lx + colW / 2, 22, "On the host's server", "title", "acc2", "middle");
  d.text(rx + colW / 2, 22, "In the browser", "title", "", "middle");

  const browserL = d.card(lx, 36, colW, "node", "Browser", "label", "asks for a page");
  const hostTop = browserL + arrowH;
  const leftX = lx + 28;
  d.line(leftX, browserL + 2, leftX, hostTop - 2);
  d.para(leftX + 10, browserL + 12, colW - 46, "GET the page; back: the page, fragment pasted in", "small", "ink");
  const hostBottom = d.card(lx, hostTop, colW, "host", "Host server", "label", serverHosts);

  const browserR = d.card(rx, 36, colW, "node", "Browser", "label", browserHosts);

  const serverTop = hostBottom + arrowH;
  d.line(leftX, hostBottom + 2, leftX, serverTop - 2);
  d.para(leftX + 10, hostBottom + 12, colW - 46, "GET /droplets/:id with x-droplet-location; back: the fragment", "small", "ink");

  const rightX = rx + 28;
  d.line(rightX, browserR + 2, rightX, serverTop - 2, "arrow dashed");
  d.para(
    rightX + 10,
    browserR + 12,
    colW - 46,
    "GET /droplets/:id (hx-get, fetch), or the element written with data-droplet-props, which renders itself",
    "small",
    "ink",
  );

  const end = d.card(8, serverTop, d.w - 16, "drop-solid", "Droplets server", "title", "the same one for every host", "small", "acc");
  return d.scene(end + 8);
}
---

<Diagram
  id="hosts"
  title="One droplets server, two ways to fetch"
  desc="Left: nine hosts fetch on their server: Express, Next.js, SvelteKit, Astro, FastAPI, Sinatra, PHP, WordPress and nginx with Server Side Includes. The browser asks the host for a page; the host's server sends GET /droplets/:id with x-droplet-location to the droplets server and pastes the fragment into the page. Right: the React single-page app and the htmx page let the browser do it: GET /droplets/:id with hx-get or fetch, or the element written with data-droplet-props, which renders itself. Both talk to the same droplets server."
  caption="Solid: the host's server fetches the fragment. Dashed: the browser does."
  wide={build(false)}
  narrow={build(true)}
/>
