{
  "name": "@dropletsjs/demo",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "The droplets the docs embed live: hello (Svelte), counter (React), poll (Vue), crash (Solid), one counter-<renderer> per renderer for the renderer pages, and five testimonials droplets, one per flag combination, with GET /api/testimonials.",
  "scripts": {
    "dev": "node scripts/dev-secret.mjs && vite",
    "build": "vite build && node scripts/export-testimonials.mjs",
    "build:cloudflare": "DROPLETS_ADAPTER=cloudflare vite build && node scripts/export-testimonials.mjs",
    "preview:cloudflare": "wrangler dev",
    "deploy:cloudflare": "pnpm run build:cloudflare && wrangler deploy",
    "start": "node --env-file-if-exists=.env.local dist/server.js",
    "sync": "djs sync",
    "clean": "rm -rf dist .wrangler",
    "typecheck": "djs sync && vue-tsc -p tsconfig.json && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run"
  },
  "dependencies": {
    "@dropletsjs/droplets": "workspace:*",
    "@dropletsjs/renderer-handlebars": "workspace:*",
    "@dropletsjs/renderer-hono-jsx": "workspace:*",
    "@dropletsjs/renderer-lit": "workspace:*",
    "@dropletsjs/renderer-preact": "workspace:*",
    "@dropletsjs/renderer-react": "workspace:*",
    "@dropletsjs/renderer-solid": "workspace:*",
    "@dropletsjs/renderer-vue": "workspace:*",
    "hono": "^4.13.16",
    "lit": "^3.3.3",
    "preact": "^11.1.1",
    "preact-render-to-string": "^6.8.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "solid-js": "^1.9.18",
    "svelte": "^5.57.3",
    "vue": "^3.5.44",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@dropletsjs/adapter-cloudflare": "workspace:*",
    "@dropletsjs/adapter-node": "workspace:*",
    "@dropletsjs/devtools": "workspace:*",
    "@dropletsjs/renderer-svelte": "workspace:*",
    "@dropletsjs/shared": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "svelte-check": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:",
    "wrangler": "catalog:"
  }
}
