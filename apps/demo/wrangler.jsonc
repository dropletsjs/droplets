// The demo droplets the docs embed, at https://demo.dropletsjs.dev.
// Deploy with `pnpm --filter @dropletsjs/demo deploy:cloudflare`; the first
// deploy uploads the form secret with `--secrets-file`, a later
// `wrangler secret put DROPLETS_SECRET` rotates it (apps/demo/README.md).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dropletsjs-demo",
  "main": "dist/worker.js",
  "compatibility_date": "2026-11-01",
  // Svelte's server renderer and the request store use AsyncLocalStorage from node:async_hooks.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    // The exported testimonials pages are served as page-<n>.html, never
    // redirected to an extensionless path.
    "html_handling": "none"
  },
  // Served only on the custom domain; no *.workers.dev or preview copies.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "demo.dropletsjs.dev", "custom_domain": true }],
  "observability": { "enabled": true }
}
