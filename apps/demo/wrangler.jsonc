// The demo droplets the docs embed, at https://demo.dropletsjs.dev.
// Build with `pnpm --filter @dropletsjs/demo build:cloudflare`, then
// `wrangler deploy` from this directory (apps/demo/README.md). The form
// secret is a Worker secret: `wrangler secret put DROPLETS_SECRET`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dropletsjs-demo",
  "main": "dist/worker.js",
  "compatibility_date": "2026-11-01",
  // Svelte's server renderer uses AsyncLocalStorage from node:async_hooks.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    // Every request reaches the Worker first, files included. /index.js is
    // dynamic (the location and the public env, no-store), and /droplets/*
    // and /assets/* get CORS and their cache headers from the Worker, which
    // reads the files through the binding.
    "run_worker_first": true
  },
  // Served only on the custom domain; no *.workers.dev or preview copies.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "demo.dropletsjs.dev", "custom_domain": true }],
  "observability": { "enabled": true }
}
