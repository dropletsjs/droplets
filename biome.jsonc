{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.js",
      "**/*.mjs",
      "**/*.cjs",
      "**/*.json",
      "**/*.jsonc",
      "**/*.css",
      "!!examples/hosts",
      "!**/CHANGELOG.md",
      "!pnpm-lock.yaml",
      "!examples/*/data/*.json"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 140
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "css": {
    "parser": { "tailwindDirectives": true }
  },
  "assist": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        // Brackets mark a key read through an index signature: a record, dataset, process.env, client input.
        "useLiteralKeys": "off"
      },
      "style": {
        // docs/style/code.md covers packages/** only; it is turned on there below.
        "noNonNullAssertion": "off",
        // Reordering the rules would change the cascade.
        "noDescendingSpecificity": "off"
      },
      "suspicious": {
        // The code generators and their tests write `${…}` into the code they emit.
        "noTemplateCurlyInString": "off",
        // `(a ??= {})` and `() => void (x = y)` are deliberate.
        "noAssignInExpressions": "off",
        // The regexes that reject control characters name them on purpose.
        "noControlCharactersInRegex": "off",
        // Public callback types: `undefined` would refuse a function that returns nothing.
        "noConfusingVoidType": "off"
      }
    }
  },
  "overrides": [
    {
      // docs/style/code.md
      "includes": ["packages/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "error",
            "noDoubleEquals": "error"
          },
          "style": {
            "noNonNullAssertion": "error",
            "useImportType": "error",
            "noEnum": "error",
            "useConst": "error",
            "noDefaultExport": "error",
            "useConsistentTypeDefinitions": { "level": "error", "options": { "style": "type" } }
          }
        }
      }
    },
    {
      // The default exports the consumer fixes: adapter entries, config files,
      // the $droplets/* modules' types and test stubs, fixture projects.
      "includes": [
        "packages/adapters/*/src/entry.ts",
        "packages/adapters/cloudflare/src/worker.ts",
        "packages/droplets/src/testing/conformance-entry.ts",
        "packages/**/*.config.ts",
        "packages/**/*.config.js",
        "packages/droplets/src/types/**",
        "packages/droplets/ambient.d.ts",
        "packages/droplets/test/stubs/**",
        "packages/**/test/fixtures/**",
        "packages/renderers/svelte/src/*.svelte.d.ts"
      ],
      "linter": { "rules": { "style": { "noDefaultExport": "off" } } }
    },
    {
      // The tests assert the fixtures' markup exactly; a test component closes over the test's own state.
      "includes": ["packages/**/test/**"],
      "linter": {
        "rules": {
          "a11y": { "useButtonType": "off" },
          "correctness": { "noComponentHookFactories": "off" }
        }
      }
    },
    {
      // The renderer hands the droplet's children element in props, with the rest.
      "includes": ["packages/renderers/react/src/**"],
      "linter": { "rules": { "correctness": { "noChildrenProp": "off" } } }
    }
  ]
}
