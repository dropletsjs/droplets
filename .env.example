# Optional settings for the repository's own scripts. Copy to .env.local
# (gitignored) and fill in what you need: the scripts that use them read
# .env.local when it exists, and a variable already set in the environment
# wins. An empty value counts as unset.

# examples/shop: pnpm generate:data, an OpenAI-compatible server.
LLM_URL=
LLM_MODEL=

# examples/shop: pnpm generate:images, a ComfyUI server (default
# http://localhost:8188) and the model files it loads.
COMFY_URL=
COMFY_UNET=
COMFY_CLIP=
COMFY_VAE=

# packages/adapters/bun and deno: the binaries, when not on the PATH.
BUN=
DENO=

# tests/hosts: move every published port into one block of a hundred.
HOSTS_PORT_BASE=
