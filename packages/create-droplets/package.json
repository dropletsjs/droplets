{
  "name": "create-droplets",
  "version": "0.1.0",
  "description": "Start a Droplets project: npm create droplets. Pick the frameworks, adapters and Tailwind; get a typed, building project with a droplet per framework.",
  "keywords": [
    "droplets",
    "create",
    "scaffold",
    "micro-frontends",
    "vite"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dropletsjs/droplets.git",
    "directory": "packages/create-droplets"
  },
  "homepage": "https://dropletsjs.dev",
  "bugs": {
    "url": "https://github.com/dropletsjs/droplets/issues"
  },
  "type": "module",
  "bin": {
    "create-droplets": "./bin/create-droplets.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "vitest run && vite build",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1"
  },
  "devDependencies": {
    "@dropletsjs/droplets": "workspace:*",
    "@types/node": "^24.9.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
