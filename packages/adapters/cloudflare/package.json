{
  "name": "@dropletsjs/adapter-cloudflare",
  "version": "0.1.0",
  "description": "Cloudflare Workers adapter for Droplets: vite build emits a self-contained dist/worker.js that serves the client build from Workers Static Assets.",
  "keywords": [
    "droplets",
    "svelte",
    "hono",
    "cloudflare",
    "workers",
    "adapter"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dropletsjs/droplets.git",
    "directory": "packages/adapters/cloudflare"
  },
  "homepage": "https://dropletsjs.dev",
  "bugs": {
    "url": "https://github.com/dropletsjs/droplets/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "dev": "tsdown --watch"
  },
  "peerDependencies": {
    "@dropletsjs/droplets": "workspace:^",
    "hono": "^4.13.16",
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@dropletsjs/config": "workspace:*",
    "@dropletsjs/droplets": "workspace:*",
    "@types/node": "^24.9.0",
    "hono": "^4.13.16",
    "tsdown": "catalog:",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
