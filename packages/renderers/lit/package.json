{
  "name": "@dropletsjs/renderer-lit",
  "version": "1.0.1",
  "description": "Lit renderer for Droplets: +droplet.lit.ts and +error.lit.ts web components, rendered with Lit SSR into declarative shadow DOM and hydrated in the browser.",
  "keywords": [
    "droplets",
    "lit",
    "web-components",
    "declarative-shadow-dom",
    "renderer",
    "micro-frontends",
    "vite-plugin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dropletsjs/droplets.git",
    "directory": "packages/renderers/lit"
  },
  "homepage": "https://dropletsjs.dev",
  "bugs": {
    "url": "https://github.com/dropletsjs/droplets/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "default": "./dist/element.js"
    },
    "./form": {
      "types": "./dist/form.d.ts",
      "default": "./dist/form.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown && vitest run",
    "build:dist": "tsdown",
    "dev": "tsdown --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@lit-labs/ssr": "^4.1.0",
    "@lit-labs/ssr-client": "^1.1.8"
  },
  "peerDependencies": {
    "@dropletsjs/droplets": "workspace:^",
    "lit": "^3.3.0",
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@dropletsjs/adapter-cloudflare": "workspace:*",
    "@dropletsjs/droplets": "workspace:*",
    "@dropletsjs/shared": "workspace:*",
    "@types/node": "^22.20.5",
    "happy-dom": "^21.0.4",
    "lit": "^3.3.3",
    "tsdown": "catalog:",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
