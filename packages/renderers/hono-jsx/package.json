{
  "name": "@dropletsjs/renderer-hono-jsx",
  "version": "0.1.0",
  "description": "Hono JSX renderer for Droplets: +droplet.tsx and +error.tsx components with hono/jsx, rendered on the server and in the browser.",
  "keywords": [
    "droplets",
    "hono",
    "jsx",
    "renderer",
    "micro-frontends",
    "vite-plugin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dropletsjs/droplets.git",
    "directory": "packages/renderers/hono-jsx"
  },
  "homepage": "https://dropletsjs.dev",
  "bugs": {
    "url": "https://github.com/dropletsjs/droplets/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./form": {
      "types": "./dist/form.d.ts",
      "default": "./dist/form.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@dropletsjs/droplets": "workspace:^",
    "hono": "^4.13.0",
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@dropletsjs/droplets": "workspace:*",
    "@types/node": "^24.9.0",
    "happy-dom": "^21.0.4",
    "hono": "^4.13.16",
    "tsdown": "catalog:",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
