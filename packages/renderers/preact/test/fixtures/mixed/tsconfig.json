{
  // The JSX default of a project Preact came to first: React's droplets, and
  // the shared module they reach, must still compile for React.
  "extends": "@dropletsjs/shared/tsconfig",
  "compilerOptions": {
    "types": ["node", "vite/client", "@dropletsjs/droplets/ambient"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "droplets.config.ts"]
}
