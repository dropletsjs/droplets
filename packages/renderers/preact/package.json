{
  "name": "@dropletsjs/renderer-preact",
  "version": "1.0.1",
  "description": "Preact renderer for Droplets: +droplet.tsx and +error.tsx components, rendered on the server and hydrated in the browser.",
  "keywords": [
    "droplets",
    "preact",
    "renderer",
    "micro-frontends",
    "vite-plugin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dropletsjs/droplets.git",
    "directory": "packages/renderers/preact"
  },
  "homepage": "https://dropletsjs.dev",
  "bugs": {
    "url": "https://github.com/dropletsjs/droplets/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./form": {
      "types": "./dist/form.d.ts",
      "default": "./dist/form.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown && vitest run",
    "build:dist": "tsdown",
    "dev": "tsdown --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prefresh/core": "^1.5.11",
    "@prefresh/utils": "^1.2.1"
  },
  "peerDependencies": {
    "@dropletsjs/droplets": "workspace:^",
    "preact": "^11.0.0",
    "preact-render-to-string": "^6.8.0",
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@dropletsjs/adapter-node": "workspace:*",
    "@dropletsjs/droplets": "workspace:*",
    "@dropletsjs/renderer-react": "workspace:*",
    "@dropletsjs/shared": "workspace:*",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^21.0.4",
    "hono": "^4.13.16",
    "preact": "^11.1.1",
    "preact-render-to-string": "^6.8.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "catalog:",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
