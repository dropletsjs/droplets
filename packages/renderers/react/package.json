{
  "name": "@dropletsjs/renderer-react",
  "version": "0.1.0",
  "description": "React 19 renderer for Droplets: +droplet.tsx and +error.tsx components, rendered on the server and hydrated in the browser.",
  "keywords": [
    "droplets",
    "react",
    "renderer",
    "micro-frontends",
    "vite-plugin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dropletsjs/droplets.git",
    "directory": "packages/renderers/react"
  },
  "homepage": "https://dropletsjs.dev",
  "bugs": {
    "url": "https://github.com/dropletsjs/droplets/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./form": {
      "types": "./dist/form.d.ts",
      "default": "./dist/form.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown && vitest run",
    "build:dist": "tsdown",
    "dev": "tsdown --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.0"
  },
  "peerDependencies": {
    "@dropletsjs/droplets": "workspace:^",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@dropletsjs/droplets": "workspace:*",
    "@dropletsjs/shared": "workspace:*",
    "@types/node": "^24.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "catalog:",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
