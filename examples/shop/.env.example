# Demo values for `pnpm dev` and `pnpm start`. Real deployments set their
# own (the login card says "admin / droplets": this is a demo shop).
ADMIN_USER=admin
ADMIN_PASSWORD=droplets
SHOP_SECRET=demo-only-secret-change-me-0123456789abcdef
# Signs the result of a form posted without JavaScript, carried back to the
# page on the redirect (Post/Redirect/Get). 32+ bytes; without it such a post
# answers the droplet's fragment instead.
DROPLETS_SECRET=demo-only-droplets-secret-change-me-0123456789
