---
import Shop from "../layouts/Shop.astro";
import { pick } from "../lib/shop.ts";
import { finish, shopPage } from "../lib/shop-page.ts";

const page = await shopPage(Astro.request, [["login", pick(new URLSearchParams(Astro.url.search), ["next"])]]);
const answered = finish(Astro, page);
if (answered) return answered;
---

<Shop title="Log in" toasts={page.toasts} cart={page.cart} head={page.head}>
  <div class="shop-narrow"><Fragment set:html={page.fragments[0]} /></div>
</Shop>
