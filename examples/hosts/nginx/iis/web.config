<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS equivalent of ../nginx.conf, as a reference. Not verified on a Windows
  host; it follows the documented URL Rewrite + Application Request Routing
  (ARR) reverse-proxy setup:

    1. Install URL Rewrite and ARR, and enable "proxy" in ARR server settings.
    2. Put this web.config next to index.html in the site root.
    3. Point DROPLETS_UPSTREAM below at the droplets server.
    4. Set HTTP_X_DROPLET_LOCATION below to the site's public URL, written
       out: never a value built from the request's Host header, which the
       client sends. List that origin in the droplets server's
       DROPLETS_TRUSTED_ORIGINS.

  IIS has no Server Side Includes for arbitrary URLs, so the page itself must
  embed the fragments another way: either an ASP.NET page that fetches
  /droplets/<id> server-side (see the express/python examples for the pattern),
  or the client-only pattern from the react-vite example.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="droplets" stopProcessing="true">
          <match url="^(index\.js|droplets/.*|assets/.*|api/.*)$" />
          <action type="Rewrite" url="http://localhost:8000/{R:0}" />
          <serverVariables>
            <set name="HTTP_X_DROPLET_LOCATION" value="https://www.example.com" />
          </serverVariables>
        </rule>
      </rules>
    </rewrite>
    <!-- Required for the serverVariables above; also allow it in applicationHost.config. -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
