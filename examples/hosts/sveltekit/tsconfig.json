{
  // `svelte-kit sync` writes .svelte-kit/tsconfig.json: $lib, ./$types and the include list.
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "types": []
  }
}
