<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Droplets in Sinatra</title>
  <script type="module" src="<%= @droplets_public_url %>/index.js"></script>
</head>
<body style="font-family: system-ui, sans-serif; background: #f8fafc; margin: 0; padding: 2rem;">
  <main style="max-width: 48rem; margin: 0 auto;">
    <h1>Sinatra page, three Svelte droplets</h1>
    <p>Each fragment below was fetched by the Ruby process and rendered on the server.
       Try <a href="/?who=Ruby">?who=Ruby</a>, or the <a href="/gallery">shop demo</a>.</p>
    <% @fragments.each do |fragment| %>
      <%= fragment %>
    <% end %>
  </main>
</body>
</html>
