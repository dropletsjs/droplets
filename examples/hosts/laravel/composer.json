{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "dropletsjs/example-host-laravel",
    "type": "project",
    "description": "Droplets and the shop demo embedded from Laravel: fragments fetched with the HTTP client, pasted into Blade.",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "laravel/framework": "^13.42"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "test": [
            "@php vendor/bin/phpunit"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
