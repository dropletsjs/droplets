# Demo values for `pnpm dev`, `pnpm build` and `pnpm start` against the
# WordPress of examples/hosts/wordpress. Never use them anywhere else.
#
# How wp-shop reaches WordPress's REST API (server to server), and the
# origin WordPress's pages and Media Library answer on (the browser's).
WP_INTERNAL_URL=http://localhost:8008
WP_PUBLIC_URL=http://localhost:8008
# Shared with the Droplets Embed plugin, one secret per direction, 32+ bytes
# each and never the same value (wp-shop refuses both if they are):
# WordPress → wp-shop, the x-wp-shop-user assertion it adds for a logged-in admin;
WP_SHOP_HOST_SECRET=demo-only-host-secret-change-me-0123456789abcdef
# wp-shop → WordPress, x-wp-shop-service on its writes back (stock and price).
WP_SHOP_SERVICE_SECRET=demo-only-service-secret-change-me-0123456789ab
# Signs the result of a form posted without JavaScript (Post/Redirect/Get).
DROPLETS_SECRET=demo-only-droplets-secret-change-me-0123456789
DROPLETS_TRUSTED_ORIGINS=http://localhost:8008
