{
  "name": "@dropletsjs/example-wp-shop",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "start:container": "sh scripts/start.sh",
    "sync": "djs sync",
    "clean": "rm -rf dist wp-shop.db wp-shop.db-* test/.tmp",
    "typecheck": "djs sync && vue-tsc -p tsconfig.json && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run"
  },
  "dependencies": {
    "@dropletsjs/droplets": "^1.0.0",
    "@dropletsjs/renderer-hono-jsx": "^1.0.0",
    "@dropletsjs/renderer-react": "^1.0.0",
    "@dropletsjs/renderer-solid": "^1.0.0",
    "better-sqlite3": "^13.0.3",
    "handlebars": "^4.7.10",
    "hono": "^4.13.16",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "solid-js": "^1.9.18",
    "svelte": "^5.57.3",
    "vue": "^3.5.44",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@dropletsjs/adapter-node": "^1.0.0",
    "@dropletsjs/devtools": "^1.0.0",
    "@dropletsjs/renderer-handlebars": "^1.0.0",
    "@dropletsjs/renderer-svelte": "^1.0.0",
    "@dropletsjs/renderer-vue": "^1.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "svelte-check": "^4.7.8",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
