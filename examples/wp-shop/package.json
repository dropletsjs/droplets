{
  "name": "@dropletsjs/example-wp-shop",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "start:container": "sh scripts/start.sh",
    "sync": "djs sync",
    "clean": "rm -rf dist wp-shop.db wp-shop.db-* test/.tmp",
    "typecheck": "djs sync && vue-tsc -p tsconfig.json && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run"
  },
  "dependencies": {
    "@dropletsjs/droplets": "workspace:*",
    "@dropletsjs/renderer-hono-jsx": "workspace:*",
    "@dropletsjs/renderer-react": "workspace:*",
    "@dropletsjs/renderer-solid": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "handlebars": "^4.7.10",
    "hono": "^4.13.16",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "solid-js": "^1.9.18",
    "svelte": "^5.57.3",
    "vue": "^3.5.44",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@dropletsjs/adapter-node": "workspace:*",
    "@dropletsjs/devtools": "workspace:*",
    "@dropletsjs/renderer-handlebars": "workspace:*",
    "@dropletsjs/renderer-svelte": "workspace:*",
    "@dropletsjs/renderer-vue": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "svelte-check": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  }
}
