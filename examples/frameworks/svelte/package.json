{
  "name": "@dropletsjs/example-svelte",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "The Droplets Svelte example: one droplet per mode, with loads, endpoints, an error page and env.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:cloudflare": "DROPLETS_ADAPTER=cloudflare vite build",
    "build:bun": "DROPLETS_ADAPTER=bun vite build",
    "build:deno": "DROPLETS_ADAPTER=deno vite build",
    "preview": "vite preview",
    "preview:cloudflare": "wrangler dev",
    "deploy:cloudflare": "wrangler deploy",
    "start": "node dist/server.js",
    "start:bun": "bun dist/server.js",
    "start:deno": "deno serve -A dist/server.js",
    "sync": "djs sync",
    "clean": "rm -rf dist .wrangler",
    "typecheck": "djs sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings"
  },
  "dependencies": {
    "@dropletsjs/droplets": "^1.0.0",
    "@dropletsjs/renderer-svelte": "^1.0.0",
    "svelte": "^5.57.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@dropletsjs/adapter-bun": "^1.0.0",
    "@dropletsjs/adapter-cloudflare": "^1.0.0",
    "@dropletsjs/adapter-deno": "^1.0.0",
    "@dropletsjs/adapter-node": "^1.0.0",
    "@dropletsjs/devtools": "^1.0.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^22.20.5",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "wrangler": "^4.157.0"
  }
}
