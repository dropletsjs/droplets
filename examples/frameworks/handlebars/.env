# Example values, committed on purpose: nothing here is secret.
# Secrets go in .env.local (ignored by git) or in the environment.

# Public, inlined at build.
PUBLIC_SITE_NAME=Droplets showcase
# Public, read at runtime: change it and restart the server, no rebuild.
PUBLIC_BANNER=Set PUBLIC_BANNER and restart: no rebuild needed
# Private, inlined at build into the server only.
BUILD_CHANNEL=example
